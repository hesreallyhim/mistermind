GH_REPO_OWNER=
GH_REPO_NAME=mistermind
GH_REPO_VISIBILITY=private
GH_REPO_DESCRIPTION=GitHub-issue-based variation of the classic game Mastermind - all gameplay happens within the repo itself.
GH_REPO_HOMEPAGE=

# Optional bootstrap token. Use this when you want the script itself to create
# the repository via the API. A fine-grained PAT scoped to the target repo
# cannot create that repo before it exists.
# If unset, scripts/bootstrap_repo.sh falls back to MISTERMIND_GH_PAT.
GH_BOOTSTRAP_TOKEN=

# Repository secrets
MISTERMIND_GH_PAT=
# Optional app-auth trial secret. Store the PEM private key as a quoted string
# with \n escapes if you want bootstrap to provision it from .env.
MISTERMIND_GH_APP_PRIVATE_KEY=
MISTERMIND_SALT=
MISTERMIND_STATE_SIGNING_SECRET=

# Repo-variable seed values. These defaults keep the variables defined while
# still meaning "inactive" to both the workflow layer and the Python runtime.
MM_PAUSED_UNTIL=0
MM_RATE_MODE=off
MM_RATE_UNTIL=0

# GitHub App hot-path settings (default actor).
MM_GH_AUTH_MODE=app
MM_AUTOMATION_LOGIN=mistermind-assistant[bot]
MISTERMIND_GH_APP_ID=0
